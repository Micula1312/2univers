---
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>2Univers Archive</title>
    <link rel="stylesheet" href="https://use.typekit.net/asm6kdm.css">
  </head>

  <body>
    

    <main id="app">
      <div class="camera-controls"></div>

      <div class="view-controls"></div>

      <div id="labelLayer" class="label-layer"></div>

      <div id="preloader" class="preloader" aria-hidden="true">
        <div class="preloader__bg"></div>

        <div class="preloader__center">
          <img
            class="preloader__dongfeng"
            src="/images/DONGFENG_Logo_White.png"
            alt=""
          />

          <img
            class="preloader__title-side preloader__title-side--left"
            src="/images/two-natures.png"
            alt=""
          />

          <img
            class="preloader__title-side preloader__title-side--right"
            src="/images/infinite-scapes.png"
            alt=""
          />
        </div>
      </div>
      <div id="archive"></div>

      <div id="trackSheet" class="track-sheet" aria-hidden="true">

        <div class="track-sheet__inner">

          <button id="closeSheet" class="track-sheet__close" type="button" aria-label="Close">
            <img src="/images/assets/btn-PLUS.png" alt="">
          </button>
          <p class="track-sheet__eyebrow">Audio Experience</p>
          <h2 id="trackTitle" class="track-sheet__title">Trace</h2>
          <p id="trackMeta" class="track-sheet__meta">Day 1 · Slot 1</p>

          <div class="track-sheet__player">
            <button id="fakePlay" class="track-sheet__play" type="button">Play</button>
            <input
              id="trackProgress"
              class="track-sheet__progress"
              type="range"
              min="0"
              max="100"
              value="0"
              step="0.1"
              aria-label="Playback progress"
            />
          </div>

          <div class="track-sheet__logo">
            <img class="track-sheet__logo-img" src="/images/mdw.png" alt="Milano Design Week 2025">
          </div>

          <div class="track-sheet__actions">

          <button id="shareTrack" class="track-sheet__icon" type="button" aria-label="Share track">
            <img src="/images/assets/btn-SHARE.png" alt="">
          </button>

            <a id="downloadTrack" class="track-sheet__icon" href="#" aria-label="Download track">
              <img src="/images/assets/btn-DOWNLOAD.png" alt="">
            </a>

          </div>
        </div>
      </div>
    </main>

    <script>
      import { initArchiveApp } from "../scripts/archive3d/archive-main.js";

      await initArchiveApp();
    </script>
  </body>
</html>