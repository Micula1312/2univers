---
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>2Univers Archive</title>
  </head>

  <body>
    <main id="app">
      <div class="intro">
        <h1>2Univers</h1>
      </div>

      <div class="camera-controls">
        <button id="zoomIn" type="button">+</button>
        <button id="zoomOut" type="button">−</button>
        <button id="resetView" type="button">Reset</button>
      </div>

	  <div id="labelLayer" class="label-layer"></div>
      <div id="archive"></div>

      <div id="trackSheet" class="track-sheet" aria-hidden="true">
        <button id="closeSheet" class="track-sheet__close" type="button">×</button>
        <div class="track-sheet__inner">
          <p class="track-sheet__eyebrow">Audio track</p>
          <h2 id="trackTitle" class="track-sheet__title">Trace</h2>
          <p id="trackMeta" class="track-sheet__meta">Day 1 · Slot 1</p>
          <button id="fakePlay" class="track-sheet__play" type="button">Play</button>
        </div>
      </div>
    </main>

    <script>
      import { initArchive } from "../scripts/archive3d/archive-scene.js";

      initArchive();
    </script>
  </body>
</html>